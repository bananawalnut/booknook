{
  "$defs": {
    "NativeAuthorityProfileSchema": {
      "enum": [
        "castalia.native-authority-profile.v1"
      ],
      "type": "string"
    },
    "NativeCaller": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[!-~](?:[ -~]*[!-~])?$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NativeCallerKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "NativeCallerKind": {
      "enum": [
        "terminal"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[!-~](?:[ -~]*[!-~])?$",
      "type": "string"
    },
    "caller": {
      "$ref": "#/$defs/NativeCaller"
    },
    "credential_endpoint": {
      "description": "Canonical HTTPS or exact-loopback HTTP. Full URL and UTF-8 byte limits are checked by the public runtime validator.",
      "format": "uri",
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^https?://[^?#]+$",
      "type": "string"
    },
    "display_name": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$",
      "type": "string"
    },
    "issuer": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[!-~](?:[ -~]*[!-~])?$",
      "type": "string"
    },
    "issuer_public_key": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "key_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[!-~](?:[ -~]*[!-~])?$",
      "type": "string"
    },
    "policy_digest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema": {
      "$ref": "#/$defs/NativeAuthorityProfileSchema"
    }
  },
  "required": [
    "schema",
    "display_name",
    "issuer",
    "key_id",
    "issuer_public_key",
    "audience",
    "caller",
    "policy_digest_sha256",
    "credential_endpoint"
  ],
  "title": "NativeAuthorityProfile",
  "type": "object",
  "$id": "urn:castalia:schema:native-authority-profile:v1"
}
