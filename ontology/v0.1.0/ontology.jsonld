{
  "@context": {
    "bn": "urn:booknook:ontology:",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "oa": "http://www.w3.org/ns/oa#"
  },
  "@id": "urn:booknook:ontology:release:0.1.0",
  "@type": "owl:Ontology",
  "owl:versionInfo": "0.1.0",
  "owl:imports": {"@id": "https://zenith-research.ca/ontology/v0.6.0/ontology.jsonld"},
  "@graph": [
    {"@id": "bn:Book", "@type": "owl:Class", "rdfs:comment": "A literary work, independent of provider and edition."},
    {"@id": "bn:Edition", "@type": "owl:Class", "rdfs:comment": "A particular expression or publication of a book."},
    {"@id": "bn:ContentAsset", "@type": "owl:Class", "rdfs:comment": "Accessible content bytes with media type and checksum; catalog ownership does not imply access."},
    {"@id": "bn:ReadingPass", "@type": "owl:Class"},
    {"@id": "bn:ReadingSession", "@type": "owl:Class"},
    {"@id": "bn:ProgressObservation", "@type": "owl:Class", "rdfs:comment": "A timestamped source-specific observation, never a cross-edition percentage mapping."},
    {"@id": "bn:Notebook", "@type": "owl:Class"},
    {"@id": "bn:Block", "@type": "owl:Class"},
    {"@id": "bn:NotebookRevision", "@type": "owl:Class"},
    {"@id": "bn:LiteraryEntity", "@type": "owl:Class"},
    {"@id": "bn:Character", "@type": "owl:Class", "rdfs:subClassOf": {"@id": "bn:LiteraryEntity"}},
    {"@id": "bn:Place", "@type": "owl:Class", "rdfs:subClassOf": {"@id": "bn:LiteraryEntity"}},
    {"@id": "bn:Theme", "@type": "owl:Class", "rdfs:subClassOf": {"@id": "bn:LiteraryEntity"}},
    {"@id": "bn:Event", "@type": "owl:Class", "rdfs:subClassOf": {"@id": "bn:LiteraryEntity"}},
    {"@id": "bn:Concept", "@type": "owl:Class", "rdfs:subClassOf": {"@id": "bn:LiteraryEntity"}},
    {"@id": "bn:CharacterCard", "@type": "owl:Class"},
    {"@id": "bn:CharacterInterpretation", "@type": "owl:Class", "rdfs:comment": "An immutable saved reader interpretation with parent versions, pass, time and supporting locations."},
    {"@id": "bn:Annotation", "@type": "owl:Class", "rdfs:subClassOf": {"@id": "oa:Annotation"}},
    {"@id": "bn:TextAnchor", "@type": "owl:Class", "rdfs:comment": "Edition/resource plus exact/prefix/suffix corresponding to oa:TextQuoteSelector; native offsets are UTF-16."},
    {"@id": "bn:InkStroke", "@type": "owl:Class"},
    {"@id": "bn:Review", "@type": "owl:Class"},
    {"@id": "bn:Rating", "@type": "owl:Class"},
    {"@id": "bn:ReadingList", "@type": "owl:Class"},
    {"@id": "bn:ReadingGroup", "@type": "owl:Class"},
    {"@id": "bn:Activity", "@type": "owl:Class"},
    {"@id": "bn:attachedToBlock", "@type": "owl:ObjectProperty", "rdfs:domain": {"@id": "bn:CharacterCard"}, "rdfs:range": {"@id": "bn:Block"}},
    {"@id": "bn:describesCharacter", "@type": "owl:ObjectProperty", "rdfs:domain": {"@id": "bn:CharacterCard"}, "rdfs:range": {"@id": "bn:Character"}},
    {"@id": "bn:derivedFromVersion", "@type": "owl:ObjectProperty"},
    {"@id": "bn:readingPass", "@type": "owl:ObjectProperty", "rdfs:range": {"@id": "bn:ReadingPass"}},
    {"@id": "bn:attributedReader", "@type": "owl:ObjectProperty", "rdfs:comment": "Descriptive attribution only; confers no operational authority."}
  ]
}
