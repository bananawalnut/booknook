{
  "$defs": {
    "AudioMetadata": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ebook_identifiers": {
          "description": "Explicit ebook identifiers reported by the source, with their namespaces.\nThe audiobook ASIN is not implicitly a Kindle ASIN or an ebook ISBN.",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "type": "array"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AudioObservation": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "type": "string"
        },
        "asin": {
          "type": "string"
        },
        "duration_milliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "edition_identifier": {
          "description": "Legacy opaque identifier retained without guessing its namespace.",
          "type": [
            "string",
            "null"
          ]
        },
        "fetched_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "position_milliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_updated_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "asin",
        "position_milliseconds",
        "source_updated_at",
        "fetched_at",
        "alignment"
      ],
      "type": "object"
    },
    "CatalogCandidate": {
      "additionalProperties": false,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "subjects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "book_id",
        "title",
        "subjects"
      ],
      "type": "object"
    },
    "CatalogInput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "kindle",
              "type": "string"
            },
            "json": {
              "type": "string"
            }
          },
          "required": [
            "format",
            "json"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "csv": {
              "type": "string"
            },
            "format": {
              "const": "goodreads",
              "type": "string"
            }
          },
          "required": [
            "format",
            "csv"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entries": {
              "items": {
                "$ref": "#/$defs/SourceCatalogEntry"
              },
              "type": "array"
            },
            "format": {
              "const": "normalized",
              "type": "string"
            }
          },
          "required": [
            "format",
            "entries"
          ],
          "type": "object"
        }
      ]
    },
    "DirectoryKind": {
      "enum": [
        "Entity",
        "Person",
        "Agent",
        "Organization",
        "Actor"
      ],
      "type": "string"
    },
    "DirectoryReference": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_iri": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DirectoryKind"
        }
      },
      "required": [
        "entity_iri",
        "kind"
      ],
      "type": "object"
    },
    "ProviderOperation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "catalog",
              "type": "string"
            },
            "source_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "content",
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source_id",
            "media_type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "positions",
              "type": "string"
            },
            "source_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "source_ids"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source_positions",
              "type": "string"
            },
            "source_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "source_ids"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entity_iri": {
              "type": "string"
            },
            "kind": {
              "const": "identity",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "entity_iri"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/$defs/RecommendationInput"
            },
            "kind": {
              "const": "recommendations",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event": true,
            "kind": {
              "const": "social_publish",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "event"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authors": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "before": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "social_fetch",
              "type": "string"
            },
            "limit": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "recipient": {
              "type": [
                "string",
                "null"
              ]
            },
            "since": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "authors",
            "recipient",
            "since",
            "before",
            "limit"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderRequest": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptor_digest": {
          "type": "string"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/ProviderOperation"
        },
        "provider_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "schema": {
          "const": "booknook.provider-request.v1",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "request_id",
        "generation",
        "provider_id",
        "descriptor_digest",
        "connection_id",
        "operation"
      ],
      "type": "object"
    },
    "ProviderResponse": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "provider_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/ProviderResult"
        },
        "schema": {
          "const": "booknook.provider-response.v1",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "request_id",
        "generation",
        "provider_id",
        "connection_id",
        "result"
      ],
      "type": "object"
    },
    "ProviderResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "catalog": {
              "$ref": "#/$defs/CatalogInput"
            },
            "kind": {
              "const": "catalog",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "catalog"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "content",
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source_id",
            "media_type",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "positions",
              "type": "string"
            },
            "observations": {
              "items": {
                "$ref": "#/$defs/AudioObservation"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "observations"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source_positions",
              "type": "string"
            },
            "observations": {
              "items": {
                "$ref": "#/$defs/SourcePosition"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "observations"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "identity",
              "type": "string"
            },
            "reference": {
              "$ref": "#/$defs/DirectoryReference"
            }
          },
          "required": [
            "kind",
            "reference"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "recommendations",
              "type": "string"
            },
            "recommendations": {
              "items": {
                "$ref": "#/$defs/Recommendation"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "recommendations"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "type": "string"
            },
            "kind": {
              "const": "social_publish",
              "type": "string"
            },
            "relays": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "event_id",
            "relays"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "events": {
              "items": true,
              "type": "array"
            },
            "kind": {
              "const": "social_fetch",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "events"
          ],
          "type": "object"
        }
      ]
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "score": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "book_id",
        "score",
        "reasons"
      ],
      "type": "object"
    },
    "RecommendationInput": {
      "additionalProperties": false,
      "description": "This type intentionally has no notebook, annotation or card fields.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/CatalogCandidate"
          },
          "type": "array"
        },
        "excluded": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "friends": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "preferred_subjects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "shared_ratings": {
          "items": {
            "$ref": "#/$defs/SharedRating"
          },
          "type": "array"
        }
      },
      "required": [
        "candidates",
        "preferred_subjects",
        "shared_ratings",
        "friends",
        "excluded"
      ],
      "type": "object"
    },
    "SharedRating": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "book_id": {
          "type": "string"
        },
        "stars": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "actor",
        "book_id",
        "stars"
      ],
      "type": "object"
    },
    "SourceCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "edition_identifiers": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "type": "array"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "subjects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "authors",
        "subjects",
        "edition_identifiers",
        "language"
      ],
      "type": "object"
    },
    "SourcePosition": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_id": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "value",
        "observed_at"
      ],
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/ProviderRequest"
    },
    "response": {
      "$ref": "#/$defs/ProviderResponse"
    },
    "schema": {
      "const": "booknook.provider-execution.v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "request",
    "response"
  ],
  "title": "ProviderExecution",
  "type": "object",
  "$id": "urn:booknook:schema:provider-execution:v1"
}
