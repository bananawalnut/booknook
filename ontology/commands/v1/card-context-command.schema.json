{
  "$defs": {
    "Alignment": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unmatched",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edition_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "const": "candidate",
              "type": "string"
            }
          },
          "required": [
            "status",
            "edition_id",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edition_id": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            },
            "status": {
              "const": "confirmed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "edition_id",
            "evidence"
          ],
          "type": "object"
        }
      ]
    },
    "AudioMetadata": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ebook_identifiers": {
          "description": "Explicit ebook identifiers reported by the source, with their namespaces.\nThe audiobook ASIN is not implicitly a Kindle ASIN or an ebook ISBN.",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "type": "array"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CapturedReadingContext": {
      "additionalProperties": false,
      "properties": {
        "pass_id": {
          "type": "string"
        },
        "position_observations": {
          "items": {
            "$ref": "#/$defs/ProgressObservation"
          },
          "type": "array"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        }
      },
      "required": [
        "pass_id",
        "positions",
        "position_observations"
      ],
      "type": "object"
    },
    "CharacterInterpretation": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "observations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "passages": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "type": "array"
        },
        "traits": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "description",
        "traits",
        "relationships",
        "observations",
        "questions",
        "passages"
      ],
      "type": "object"
    },
    "Location": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "edition_id": {
              "type": "string"
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "edition_id",
            "resource",
            "quote",
            "prefix",
            "suffix"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chapter": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "audio",
              "type": "string"
            },
            "milliseconds": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "provider": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "source_id",
            "milliseconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider",
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "source_id",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edition_id": {
              "type": "string"
            },
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "edition_id",
            "page"
          ],
          "type": "object"
        }
      ]
    },
    "ProgressObservation": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/Alignment"
        },
        "audio_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "observed_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pass_id": {
          "type": "string"
        },
        "provider_connection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "received_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "pass_id",
        "location",
        "observed_at",
        "received_at",
        "alignment"
      ],
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "description"
      ],
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "capture_context": {
          "$ref": "#/$defs/CapturedReadingContext"
        },
        "card_id": {
          "type": "string"
        },
        "interpretation": {
          "$ref": "#/$defs/CharacterInterpretation"
        },
        "op": {
          "const": "save_card_with_context",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "card_id",
        "parents",
        "interpretation",
        "at",
        "capture_context"
      ],
      "type": "object"
    }
  ],
  "title": "CardContextCommand",
  "$id": "urn:booknook:schema:card-context-command:v1"
}
