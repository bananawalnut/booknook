{
  "$defs": {
    "Alignment": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unmatched",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edition_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "const": "candidate",
              "type": "string"
            }
          },
          "required": [
            "status",
            "edition_id",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edition_id": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            },
            "status": {
              "const": "confirmed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "edition_id",
            "evidence"
          ],
          "type": "object"
        }
      ]
    },
    "AudioMetadata": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ebook_identifiers": {
          "description": "Explicit ebook identifiers reported by the source, with their namespaces.\nThe audiobook ASIN is not implicitly a Kindle ASIN or an ebook ISBN.",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "type": "array"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Location": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "edition_id": {
              "type": "string"
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "edition_id",
            "resource",
            "quote",
            "prefix",
            "suffix"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chapter": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "audio",
              "type": "string"
            },
            "milliseconds": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "provider": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "source_id",
            "milliseconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider",
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "source_id",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edition_id": {
              "type": "string"
            },
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "edition_id",
            "page"
          ],
          "type": "object"
        }
      ]
    },
    "NoteFace": {
      "enum": [
        "text",
        "whiteboard"
      ],
      "type": "string"
    },
    "NoteOrigin": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pass_id": {
          "type": "string"
        },
        "position_observations": {
          "items": {
            "$ref": "#/$defs/ProgressObservation"
          },
          "type": "array"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        },
        "reader": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/NoteOriginSource"
        }
      },
      "required": [
        "source",
        "reader",
        "pass_id",
        "positions",
        "position_observations"
      ],
      "type": "object"
    },
    "NoteOriginSource": {
      "enum": [
        "recorded",
        "history_fallback",
        "unknown",
        "pending"
      ],
      "type": "string"
    },
    "ProgressObservation": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/Alignment"
        },
        "audio_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "observed_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pass_id": {
          "type": "string"
        },
        "provider_connection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "received_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "pass_id",
        "location",
        "observed_at",
        "received_at",
        "alignment"
      ],
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created": {
      "$ref": "#/$defs/NoteOrigin"
    },
    "face": {
      "$ref": "#/$defs/NoteFace"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "face",
    "created"
  ],
  "title": "NoteMetadata",
  "type": "object",
  "$id": "urn:booknook:schema:0.3.0:note"
}
