{
  "$defs": {
    "AdmissionConsent": {
      "additionalProperties": false,
      "description": "An explicit, signed permission to show this membership acceptance to the group's\ncurrent and future admitted members. It never permits sharing the invitation or notes.",
      "properties": {
        "disclosure": {
          "$ref": "#/$defs/AdmissionDisclosure"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "group_id": {
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "epoch",
        "expires_at",
        "disclosure"
      ],
      "type": "object"
    },
    "AdmissionDisclosure": {
      "enum": [
        "current_and_future_group_members"
      ],
      "type": "string"
    },
    "ApprovedPublication": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "event": {
          "$ref": "#/$defs/SocialEvent"
        },
        "presentation_json": {
          "type": "string"
        },
        "request_json": {
          "description": "Original strict JSON, not a permissively parsed map that could erase duplicate keys.",
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "event",
        "approved_at",
        "request_json",
        "presentation_json"
      ],
      "type": "object"
    },
    "ArchiveBinding": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/BindingDocument"
        },
        "minimum_version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "document",
        "minimum_version"
      ],
      "type": "object"
    },
    "BindingDocument": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "binding": {
          "$ref": "#/$defs/KeyBinding"
        },
        "presentation_json": {
          "type": "string"
        },
        "request_json": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "binding",
        "approved_at",
        "request_json",
        "presentation_json"
      ],
      "type": "object"
    },
    "BindingHistory": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/BindingDocument"
        },
        "retired_at": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "document"
      ],
      "type": "object"
    },
    "BookReference": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "id": {
          "description": "A portable catalog identifier, such as an ISBN URN or a provider identifier.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "author"
      ],
      "type": "object"
    },
    "Delivery": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "public",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "direct",
              "type": "string"
            },
            "recipients": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "recipients"
          ],
          "type": "object"
        }
      ]
    },
    "FriendshipIntent": {
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "requested",
        "version"
      ],
      "type": "object"
    },
    "Invitation": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "group_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "invitee": {
          "type": "string"
        },
        "inviter": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "group_id",
        "inviter",
        "invitee",
        "epoch",
        "expires_at",
        "accepted"
      ],
      "type": "object"
    },
    "JoinRequest": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "group_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "reader": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "group_id",
        "reader",
        "epoch",
        "expires_at"
      ],
      "type": "object"
    },
    "KeyBinding": {
      "additionalProperties": false,
      "properties": {
        "castalia_holder": {
          "type": "string"
        },
        "nostr_public_key": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "valid_from": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "valid_until": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "castalia_holder",
        "nostr_public_key",
        "valid_from",
        "valid_until",
        "version"
      ],
      "type": "object"
    },
    "OutboxItem": {
      "additionalProperties": false,
      "properties": {
        "acknowledged": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "description": "Acknowledgments are recorded per intended recipient; no acknowledgment means retry.",
          "type": "object"
        },
        "publication": {
          "$ref": "#/$defs/ApprovedPublication"
        }
      },
      "required": [
        "publication",
        "acknowledged"
      ],
      "type": "object"
    },
    "PendingEnvelope": {
      "additionalProperties": false,
      "properties": {
        "event_json": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "event_json",
        "reason"
      ],
      "type": "object"
    },
    "Post": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "book": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/PostKind"
        },
        "reading_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "reply_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "spoiler": {
          "type": "boolean"
        },
        "stars": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "body",
        "spoiler"
      ],
      "type": "object"
    },
    "PostKind": {
      "enum": [
        "review",
        "rating",
        "reading_update",
        "note",
        "discussion"
      ],
      "type": "string"
    },
    "ReadingGroup": {
      "additionalProperties": false,
      "properties": {
        "banned": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "closed": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "moderators": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "private": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "owner",
        "name",
        "description",
        "private",
        "epoch",
        "members",
        "moderators",
        "banned",
        "closed"
      ],
      "type": "object"
    },
    "SharedList": {
      "additionalProperties": false,
      "properties": {
        "books": {
          "items": {
            "$ref": "#/$defs/BookReference"
          },
          "type": "array"
        },
        "deleted": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "owner",
        "name",
        "description",
        "books",
        "version",
        "deleted"
      ],
      "type": "object"
    },
    "SocialAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Both independently signed requests must be true before a friendship exists.",
          "properties": {
            "op": {
              "const": "friendship",
              "type": "string"
            },
            "peer": {
              "type": "string"
            },
            "requested": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "peer",
            "requested"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "group_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "op": {
              "const": "publish",
              "type": "string"
            },
            "post": {
              "$ref": "#/$defs/Post"
            }
          },
          "required": [
            "op",
            "post"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "type": "string"
            },
            "op": {
              "const": "retract",
              "type": "string"
            }
          },
          "required": [
            "op",
            "event_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "books": {
              "items": {
                "$ref": "#/$defs/BookReference"
              },
              "type": "array"
            },
            "description": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "op": {
              "const": "create_list",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "name",
            "description",
            "books"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "books": {
              "items": {
                "$ref": "#/$defs/BookReference"
              },
              "type": "array"
            },
            "description": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "op": {
              "const": "update_list",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "name",
            "description",
            "books"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "op": {
              "const": "delete_list",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "op": {
              "const": "create_group",
              "type": "string"
            },
            "private": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "id",
            "name",
            "description",
            "private"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An owner-signed snapshot bootstraps an invitee without exposing private discovery.",
          "properties": {
            "expires_at": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "group": {
              "$ref": "#/$defs/ReadingGroup"
            },
            "id": {
              "type": "string"
            },
            "invitee": {
              "type": "string"
            },
            "op": {
              "const": "invite",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "group",
            "invitee",
            "expires_at"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "admission_consent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AdmissionConsent"
                },
                {
                  "type": "null"
                }
              ]
            },
            "invitation_id": {
              "type": "string"
            },
            "op": {
              "const": "accept_invitation",
              "type": "string"
            }
          },
          "required": [
            "op",
            "invitation_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Public consent enables independent verification of public group membership.",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "op": {
              "const": "request_join",
              "type": "string"
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Adding members requires current consent: a private accepted invitation or public request.",
          "properties": {
            "admission_proofs": {
              "items": {
                "$ref": "#/$defs/ApprovedPublication"
              },
              "type": "array"
            },
            "group_id": {
              "type": "string"
            },
            "members": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "moderators": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "op": {
              "const": "set_members",
              "type": "string"
            }
          },
          "required": [
            "op",
            "group_id",
            "members",
            "moderators"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ban_actor": {
              "type": [
                "string",
                "null"
              ]
            },
            "event_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "group_id": {
              "type": "string"
            },
            "op": {
              "const": "moderate",
              "type": "string"
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "group_id": {
              "type": "string"
            },
            "op": {
              "const": "close_group",
              "type": "string"
            }
          },
          "required": [
            "op",
            "group_id"
          ],
          "type": "object"
        }
      ]
    },
    "SocialEvent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/SocialAction"
        },
        "actor": {
          "type": "string"
        },
        "at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "id": {
          "type": "string"
        },
        "resource_version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "id",
        "actor",
        "at",
        "resource_version",
        "delivery",
        "action"
      ],
      "type": "object"
    },
    "SocialState": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "drafts": {
          "additionalProperties": {
            "$ref": "#/$defs/SocialEvent"
          },
          "type": "object"
        },
        "friendship_intents": {
          "additionalProperties": {
            "$ref": "#/$defs/FriendshipIntent"
          },
          "type": "object"
        },
        "groups": {
          "additionalProperties": {
            "$ref": "#/$defs/ReadingGroup"
          },
          "type": "object"
        },
        "hidden": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "invitations": {
          "additionalProperties": {
            "$ref": "#/$defs/Invitation"
          },
          "type": "object"
        },
        "join_requests": {
          "additionalProperties": {
            "$ref": "#/$defs/JoinRequest"
          },
          "default": {},
          "type": "object"
        },
        "lists": {
          "additionalProperties": {
            "$ref": "#/$defs/SharedList"
          },
          "type": "object"
        },
        "outbox": {
          "additionalProperties": {
            "$ref": "#/$defs/OutboxItem"
          },
          "type": "object"
        },
        "preferred_subjects": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "publications": {
          "additionalProperties": {
            "$ref": "#/$defs/ApprovedPublication"
          },
          "type": "object"
        },
        "replay": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Receipt nonce -> exact event digest. Consumed in the same persistence transaction.",
          "type": "object"
        },
        "retracted": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "revision",
        "drafts",
        "outbox",
        "publications",
        "friendship_intents",
        "lists",
        "groups",
        "invitations",
        "blocked",
        "hidden",
        "retracted",
        "replay",
        "preferred_subjects"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_history": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BindingHistory"
      },
      "type": "array"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/ArchiveBinding"
      },
      "type": "array"
    },
    "pending": {
      "items": {
        "$ref": "#/$defs/PendingEnvelope"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/SocialState"
    }
  },
  "required": [
    "schema",
    "state",
    "bindings",
    "pending"
  ],
  "title": "SocialArchiveBundle",
  "type": "object",
  "$id": "urn:booknook:schema:social-archive:v1"
}
