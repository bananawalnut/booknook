  "api": {
    "rust": [
      "FeedSourceSession::new(configuration, installed_descriptors)",
      "session.activate(source_id, provider_id)",
      "session.begin(source_id) / begin_with_conditional(source_id, hint)",
      "attempt.execute(&dyn FeedSourceProvider).await",
      "read.store(&dyn FeedCacheStore).await",
      "read.with_current_cache_commit(actual_existing_bytes, synchronous_atomic_CAS)"
    ],
    "native": [
      "FeedSourceSessionV1::new(configuration_bytes, Box<dyn FeedSourceHostV1>)",
      "activate(source_id); begin(source_id, optional_hint_bytes)",
      "attempt.execute().await -> Arc<FeedSourceReadV1>",
      "read.store(Box<dyn FeedCacheHostV1>).await",
      "FeedCacheHostV1::stage(...).await -> FeedCacheStageV1 {reference,existing_body}",
      "FeedCacheHostV1::compare_and_store(reference, checked_condition_json, untrusted_body) is synchronous"
    ],
    "typescript": [
      "new BookNookFeedSourcesV1(actualWasm, configurationBytes, executableHostProvider)",
      "sources.activate(sourceId)",
      "await sources.fetch(sourceId, abortSignal, optionalHintBytes)",
      "await read.store(hostCacheStore, abortSignal)",
      "hostCacheStore.stage(...).await -> {committer,existingBody?}",
      "committer.compare_and_store(conditionJson,untrustedBody): undefined",
      "read.close(); sources.close()"
    ],
    "swift": [
      "BookNookFeedSourcesV1(configuration: Data, provider: any BookNookFeedSourceProviderV1)",
      "activate(sourceID: String)",
      "await fetch(sourceID: String, conditional: Data? = nil)",
      "await read.store(any BookNookFeedCacheStoreV1)",
      "stage(...).await -> BookNookFeedCacheStageV1(reference:existingBody:)",
      "compareAndStore(staged:conditionJSON:untrustedBody:) is synchronous"
    ]
  },
